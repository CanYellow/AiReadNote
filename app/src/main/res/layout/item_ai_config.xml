<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="16dp" android:gravity="center_vertical"
    android:layout_marginBottom="8dp" android:background="#F0F0F0">
    
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_config_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_config_details" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#666"/>
    </LinearLayout>
    
    <Switch android:id="@+id/switch_config_active" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="启用"/>
</LinearLayout>
