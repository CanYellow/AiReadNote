<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="12dp"
    android:layout_marginBottom="8dp" android:background="#F0F0F0">
    <TextView android:id="@+id/tv_notebook" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#888888"/>
    <TextView android:id="@+id/tv_selected_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="italic" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/tv_thought" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/tv_ai_response" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#0066CC" android:layout_marginTop="4dp"/>
</LinearLayout>
