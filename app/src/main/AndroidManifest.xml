<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 新增：网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application 
        android:label="悦读"
        android:icon="@mipmap/ic_launcher">
        
        <activity 
            android:name=".MainActivity" 
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".SettingsActivity" android:exported="false" />
        <activity android:name=".NotebookManagerActivity" android:exported="false" />
        <activity android:name=".NoteDetailActivity" android:exported="false" />

        <activity 
            android:name=".CaptureActivity" 
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog">
            <!-- 适配 ColorDict 协议 (Moon+ Reader) -->
            <intent-filter>
                <action android:name="colordict.intent.action.SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- 适配 Android 原生文本选择菜单 -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 适配标准分享功能 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
